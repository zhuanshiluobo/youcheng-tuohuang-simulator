    m_MaxSize: 40
    m_Alignment: 3
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\u623f\u95f4\u914d\u7f6e\n\n\u623f\u4e3b\u53ef\u9009\u62e9\u4e09\u4eba\u6216\u56db\u4eba\u5730\u56fe\u3002\u6ee1\u56db\u4eba\u65f6\u81ea\u52a8\u4f7f\u7528\u56db\u4eba\u5730\u56fe\uff1b\u51cf\u5458\u540e\u4fdd\u7559\u5f53\u524d\u9009\u62e9\u3002\n\n\u57fa\u7840\u5185\u5bb9\u56fa\u5b9a\u542f\u7528\u3002\u611f\u67d3\u8005\u4f9d\u8d56\u4f01\u4e1a\u3002\u4f01\u4e1a\u5bb6\u662f\u72ec\u7acb\u6a21\u5f0f\uff0c\u5c1a\u672a\u5b9e\u73b0\uff0c\u4e0d\u80fd\u542f\u7528\u3002\n\n\u51c6\u5907\u4e0e\u5f00\u59cb\n\n\u8054\u673a\u6210\u5458\u9700\u786e\u8ba4\u5f53\u524d\u914d\u7f6e\u5e76\u70b9\u51fb\u51c6\u5907\u3002\u672c\u5730\u70ed\u5ea7\u7531\u623f\u4e3b\u7edf\u4e00\u5f00\u59cb\u3002\u5730\u56fe\u3001\u6269\u5c55\u6216\u5ea7\u4f4d\u53d8\u5316\u4f1a\u53d6\u6d88\u4eba\u5de5\u51c6\u5907\u3002\u623f\u4e3b\u70b9\u51fb\u5f00\u59cb\u786e\u8ba4\u5f53\u524d\u914d\u7f6e\uff1b\u8fde\u63a5\u3001\u8eab\u4efd\u3001\u5185\u5bb9\u7248\u672c\u548c\u80fd\u529b\u4ecd\u7531\u623f\u95f4\u670d\u52a1\u590d\u9a8c\u3002\n\n\u5ea7\u4f4d\n\n\u5f00\u653e\u7a7a\u5ea7\u53ef\u5173\u95ed\uff0c\u4e5f\u53ef\u91cd\u65b0\u5f00\u542f\u3002\u8054\u673a\u6362\u5230\u6709\u4eba\u5ea7\u4f4d\u9700\u5bf9\u65b9\u786e\u8ba4\uff1b\u672c\u5730\u70ed\u5ea7\u7531\u623f\u4e3b\u76f4\u63a5\u6362\u5ea7\u3002\u5ea7\u4f4d\u989c\u8272\u7559\u5728\u539f\u4f4d\u7f6e\uff0c\u623f\u4e3b\u8eab\u4efd\u8ddf\u968f\u73a9\u5bb6\u3002\n\n\u670d\u52a1\u72b6\u6001\n\nSteam \u597d\u53cb\u9080\u8bf7\u6309\u5f53\u524d\u670d\u52a1\u53ef\u7528\u6027\u5f00\u653e\u3002\u672c\u5730\u623f\u95f4\u652f\u6301\u6dfb\u52a0\u548c\u79fb\u9664\u70ed\u5ea7\u73a9\u5bb6\uff0c\u5207\u6362\u8054\u673a\u524d\u8bf7\u79fb\u9664\u70ed\u5ea7\u73a9\u5bb6\u3002\u5bc6\u7801\u3001\u4eba\u673a\u548c\u79fb\u9664\u8054\u673a\u6210\u5458\u6682\u4e0d\u53ef\u7528\u3002\u5b8c\u6574\u4f01\u4e1a\u548c\u611f\u67d3\u8005\u73a9\u6cd5\u4ecd\u9700\u540e\u7eed\u6574\u5408\u9a8c\u6536\u3002"
