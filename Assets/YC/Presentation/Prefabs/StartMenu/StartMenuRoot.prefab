    Caption: "\u53ea\u6709\u623f\u4e3b\u53ef\u4ee5\u4fee\u6539\u914d\u7f6e\u3002"
  - Code: configuration_stale
    Caption: "\u623f\u95f4\u914d\u7f6e\u5df2\u53d8\u5316\uff0c\u8bf7\u6309\u6700\u65b0\u72b6\u6001\u91cd\u8bd5\u3002"
