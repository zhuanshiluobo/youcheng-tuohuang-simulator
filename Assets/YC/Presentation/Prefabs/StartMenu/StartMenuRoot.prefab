    Caption: "\u5f53\u524d\u5b9e\u9645\u4eba\u6570\u4e0d\u6ee1\u8db3\u5f00\u5c40\u6761\u4ef6\u3002"
  - Code: map_requires_four_player
    Caption: "\u56db\u540d\u73a9\u5bb6\u5fc5\u987b\u4f7f\u7528\u56db\u4eba\u5730\u56fe\u3002"
  - Code: missing_enterprise_dependency
    Caption: "\u542f\u7528\u611f\u67d3\u8005\u9700\u8981\u540c\u65f6\u542f\u7528\u4f01\u4e1a\u3002"
  - Code: rule_mode_not_implemented
    Caption: "\u4f01\u4e1a\u5bb6\u6a21\u5f0f\u5c1a\u672a\u5b9e\u73b0\uff0c\u4e0d\u80fd\u542f\u7528\u3002"
  - Code: content_not_ready
    Caption: "\u6240\u9009\u5185\u5bb9\u7ec4\u5408\u6216\u4eba\u6570\u914d\u65b9\u5c1a\u672a\u5b8c\u6210\u3002"
  - Code: content_version_mismatch
    Caption: "\u73a9\u5bb6\u5185\u5bb9\u6216\u89c4\u5219\u7248\u672c\u4e0e\u623f\u95f4\u4e0d\u4e00\u81f4\u3002"
  - Code: player_not_ready
    Caption: "\u7b49\u5f85\u6210\u5458\u8fde\u63a5\u3001\u8eab\u4efd\u9a8c\u8bc1\u53ca\u5f53\u524d\u914d\u7f6e\u51c6\u5907\u3002"
  - Code: seat_occupied
    Caption: "\u76ee\u6807\u5ea7\u4f4d\u5df2\u5360\u7528\u6216\u5173\u95ed\u3002"
  - Code: seat_swap_stale
    Caption: "\u6362\u5ea7\u8bf7\u6c42\u5df2\u5931\u6548\uff0c\u8bf7\u91cd\u65b0\u7533\u8bf7\u3002"
  - Code: service_unavailable
    Caption: "\u8be5\u670d\u52a1\u6682\u4e0d\u53ef\u7528\u3002"
  - Code: room_protocol_mismatch
    Caption: "\u623f\u95f4\u534f\u8bae\u4e0d\u5339\u914d\u3002"
  - Code: legacy_entity_state_unsupported
    Caption: "\u65e7\u5bf9\u5c40\u72b6\u6001\u65e0\u6cd5\u53ef\u9760\u6062\u590d\u3002"
