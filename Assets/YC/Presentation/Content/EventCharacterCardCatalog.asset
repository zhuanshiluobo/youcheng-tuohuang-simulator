    name: "\u6E05\u7406\u866B\u5DE2"
    description: "\u591A\u65B9\u52BF\u529B\u5782\u6D8E\u8FD9\u5EA7\u5916\u9732\u7684\u5F02\u94C1\u77FF\u5E8A\u5DF2\u4E45\uFF0C\u4F46\u5374\u4ECE\u672A\u6709\u4EBA\u4E0B\u624B\u2014\u2014\u56E0\u4E3A\u8FD9\u91CC\u76D8\u8E1E\u7684\u6E90\u77F3\u866B\u591A\u5230\u8DB3\u4EE5\u6DF9\u6CA1\u6574\u5EA7\u805A\u843D\u3002\u597D\u5728\uFF0C\u4F60\u7684\u624B\u4E0B\u6B63\u597D\u6709\u8FD9\u4E48\u51E0\u4E2A\u843D\u9B44\u672F\u58EB\uFF0C\u64C5\u957F\u9A71\u8D76\u6B64\u7C7B\u5BB3\u866B\uFF0C\u4E0D\u4E45\u6E90\u77F3\u866B\u5C31\u88AB\u201C\u6C38\u4E45\u632A\u4E86\u7A9D\u201D\u3002"
