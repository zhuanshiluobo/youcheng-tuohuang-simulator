{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NoMadCity 外部内容包清单",
  "type": "object",
  "required": [
    "schemaVersion",
    "packId",
    "version",
    "definitions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "packId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "definitions": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "enabledExpansionIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "按规则扩展归属选择内容；省略时选择所有 enabled 定义。替换目标依赖必须同时启用。"
    },
    "sharedArtwork": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "facilityInventory": {
      "type": "string",
      "minLength": 1
    }
  },
  "anyOf": [
    {
      "required": [
        "facilityInventory"
      ]
    },
    {
      "properties": {
        "definitions": {
          "minItems": 1
        }
      }
    }
  ]
}
