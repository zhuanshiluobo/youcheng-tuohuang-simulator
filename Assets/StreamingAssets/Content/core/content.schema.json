{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NoMadCity 外部内容定义",
  "type": "object",
  "required": [
    "definitionId",
    "contentType",
    "version",
    "displayName",
    "artwork",
    "abilities",
    "data",
    "expansionId",
    "replaces"
  ],
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "definitionId": {
      "type": "string",
      "minLength": 1
    },
    "contentType": {
      "enum": [
        "character",
        "facility",
        "event",
        "city_style",
        "enterprise_board",
        "entrepreneur_ability",
        "entrepreneur_round",
        "award",
        "component",
        "contract"
      ]
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "artwork": {
      "type": "string",
      "description": "相对于内容包根目录的 PNG/JPEG 路径"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "playerMarkerZones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "zoneId",
          "capacity"
        ],
        "properties": {
          "zoneId": {
            "type": "string",
            "minLength": 1
          },
          "capacity": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "abilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "abilityId",
          "mode",
          "subscriptionId",
          "script",
          "version",
          "skillType"
        ],
        "properties": {
          "abilityId": {
            "type": "string"
          },
          "mode": {
            "type": "string"
          },
          "subscriptionId": {
            "type": "string"
          },
          "script": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "completionHandlerId": {
            "type": "string"
          },
          "cleanupScript": {
            "type": "string"
          },
          "skillType": {
            "enum": [
              "normal",
              "persistent",
              "one_shot"
            ]
          },
          "hasSpecialZone": {
            "type": "boolean"
          },
          "specialZoneId": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "skillType": {
                  "const": "persistent"
                }
              }
            },
            "then": {
              "required": [
                "hasSpecialZone"
              ]
            }
          },
          {
            "if": {
              "required": [
                "hasSpecialZone"
              ],
              "properties": {
                "hasSpecialZone": {
                  "const": true
                }
              }
            },
            "then": {
              "required": [
                "specialZoneId"
              ],
              "properties": {
                "skillType": {
                  "const": "persistent"
                },
                "specialZoneId": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "else": {
              "properties": {
                "specialZoneId": {
                  "const": ""
                }
              }
            }
          }
        ]
      }
    },
    "data": {
      "type": "object"
    },
    "expansionId": {
      "type": "string",
      "minLength": 1
    },
    "replaces": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "expansionId",
            "contentType",
            "definitionId"
          ],
          "properties": {
            "expansionId": {
              "type": "string",
              "minLength": 1
            },
            "contentType": {
              "type": "string",
              "minLength": 1
            },
            "definitionId": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "dataTemplate": {
      "type": "string",
      "description": "设施共用数据模板的包内 JSON 相对路径；data 保存本实体差异。"
    },
    "artworkSpriteId": {
      "type": "string",
      "minLength": 1,
      "description": "artwork_slices.json 中的稳定切片 ID，artwork 路径必须与其整图一致。"
    },
    "abilitySources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/abilitySource"
      }
    },
    "abilityHandlers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/abilityHandler"
      }
    },
    "actionCallPolicies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/actionCallPolicy"
      }
    },
    "cubeAppearance": {
      "type": "object",
      "required": [
        "color"
      ],
      "additionalProperties": false,
      "properties": {
        "color": {
          "$ref": "#/$defs/cubeColor"
        }
      }
    },
    "usageTracks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/usageTrack"
      }
    },
    "cardZones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slots": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "applicableModes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "standard",
          "entrepreneur"
        ]
      }
    },
    "requiredCapabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "abilitySource": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [{ "if": { "properties": { "repeatPolicy": { "const": "unbounded" } }, "required": ["repeatPolicy"] }, "then": { "properties": { "kind": { "const": "cleanup" } } } }],
      "required": [
        "protocolVersion",
        "abilityId",
        "kind",
        "handlerRef",
        "declarationVersion",
        "authorizationPolicy",
        "effectiveZones",
        "presentationRef"
      ],
      "properties": {
        "repeatPolicy": { "type": "string", "enum": ["once", "unbounded"], "default": "once" },
        "definitionId": {
          "type": "string"
        },
        "abilityId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "event",
            "cleanup",
            "quick",
            "special",
            "ruleQuery",
            "setup"
          ]
        },
        "handlerRef": {
          "type": "string",
          "minLength": 1
        },
        "declarationVersion": {
          "type": "string",
          "minLength": 1
        },
        "activeFaceId": {
          "type": "string"
        },
        "authorizationPolicy": {
          "enum": [
            "controller",
            "holder",
            "owner",
            "character_covered",
            "character_subscription",
            "active_selection",
            "public_declaration"
          ]
        },
        "presentationRef": {
          "type": "string",
          "minLength": 1
        },
        "protocolVersion": {
          "const": 1
        },
        "effectiveZones": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "observedEvents": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "queryKinds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "allowedOperations": {
          "description": "载体v2许可：carrier.load / carrier.store / carrier.pay.original_supply / carrier.pay.retired，后接:目标definitionId:实际localZoneId:接受typeId；不得使用通配符。",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/abilityAction"
          }
        }
      }
    },
    "abilityAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actionId",
        "entryKind",
        "bodyHandlerRef",
        "presentationRef"
      ],
      "properties": {
        "actionId": {
          "type": "string",
          "minLength": 1
        },
        "entryKind": {
          "enum": [
            "quick",
            "special"
          ]
        },
        "bodyHandlerRef": {
          "type": "string",
          "minLength": 1
        },
        "entryCostRef": {
          "type": "string"
        },
        "entryAfterEffectsRef": {
          "type": "string"
        },
        "usageTrackId": {
          "type": "string"
        },
        "lifecyclePolicy": {
          "enum": [
            "unbounded",
            "once",
            "round",
            "action_round",
            "position"
          ]
        },
        "lockPolicy": {
          "enum": [
            "none",
            "character_action_round"
          ]
        },
        "directCallPolicy": {
          "type": "string"
        },
        "presentationRef": {
          "type": "string",
          "minLength": 1
        },
        "sortOrder": {
          "type": "integer"
        }
      }
    },
    "abilityHandler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handlerId",
        "script",
        "version"
      ],
      "properties": {
        "handlerId": {
          "type": "string",
          "minLength": 1
        },
        "script": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "completionHandlerId": {
          "type": "string"
        }
      }
    },
    "actionCallPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyRef",
        "callerAbilityId",
        "targetActionId"
      ],
      "properties": {
        "policyRef": {
          "type": "string"
        },
        "callerAbilityId": {
          "type": "string"
        },
        "targetActionId": {
          "type": "string"
        },
        "callerHandlerRef": {
          "type": "string"
        },
        "callerHandlerHash": {
          "type": "string"
        },
        "omitEntryCost": {
          "type": "boolean"
        },
        "omitEntryAfterEffects": {
          "type": "boolean"
        },
        "omitMainAction": {
          "type": "boolean"
        }
      }
    },
    "cubeColor": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "mode"
          ],
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "owner_player"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "mode",
            "name",
            "rgb"
          ],
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "fixed"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "rgb": {
              "type": "string",
              "pattern": "^[0-9A-Fa-f]{6}$"
            }
          }
        }
      ]
    },
    "usageTransition": {
      "type": "object",
      "required": [
        "fromSlotId",
        "toSlotId"
      ],
      "additionalProperties": false,
      "properties": {
        "fromSlotId": {
          "type": "string",
          "minLength": 1
        },
        "toSlotId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "usageTrack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trackId",
        "version",
        "cardZoneLocalId",
        "slots",
        "initialSlotId",
        "activationTransitions",
        "resetTransitions",
        "resetBoundary",
        "initializationPolicy",
        "usageGroupScope"
      ],
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "definitionId": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "trackId": {
          "type": "string",
          "minLength": 1
        },
        "cardZoneLocalId": {
          "type": "string",
          "minLength": 1
        },
        "slots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "initialSlotId": {
          "type": "string",
          "minLength": 1
        },
        "activationTransitions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/usageTransition"
          }
        },
        "resetTransitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/usageTransition"
          }
        },
        "resetBoundary": {
          "const": "all_cleanup_completed"
        },
        "initializationPolicy": {
          "enum": [
            "owner_supply_or_retrieve",
            "public_declaration"
          ]
        },
        "usageGroupScope": {
          "const": "source_player_round"
        }
      }
    }
  }
}
