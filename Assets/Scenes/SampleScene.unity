    confirmPrompt: "\u786E\u8BA4\u540E\u5F00\u59CB\u652F\u4ED8\u548C\u7ED3\u7B97\uFF0C\u4E0D\u80FD\u518D\u64A4\u9500\uFF1B\u786E\u8BA4\u524D\u53EF\u6309
