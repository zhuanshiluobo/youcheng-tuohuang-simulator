+                    OnAppliedLocally = _ =>
+                    {
+                        interactionRouter?.NotifyCommandSettled(commandId);
+                        SynchronizeInteractionFromState();
+                    }
+                });
+            if (outcome.Kind == SubmitOutcomeKind.NoResult)
+            {
+                interactionRouter?.NotifyCommandSettled(commandId);
