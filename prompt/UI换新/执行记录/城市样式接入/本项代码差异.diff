+                    binding.Image.color = new Color(0.12f, 0.08f, 0.04f, 0.18f);
+                    binding.Outline.effectColor = UiTheme.GoldOutlineThin;
+                    binding.Outline.effectDistance = view.CardInteractionLayoutProfile.NormalOutlineDistance;
+                }
