  "assetCatalog": "assets/effect-assets.json",
  "assetBindings": {
    "background": "row-bg-{state}",
    "frame": "row-frame-{state}",
    "rightBackground": "status-bg-{state}",
    "rightIcon": "icon-{status}-{ink}",
    "detailToggle": "toggle-bg-{default,hover,pressed,expanded}",
    "detailChevron": "icon-chevron-{down,up}-{ink}",
    "rowStates": [
      "default",
      "hover",
      "pressed",
      "disabled"
    ],
    "iconInks": [
      "light",
      "dark",
      "muted"
    ],
    "rendererAssetPrefix": "v33-"
  },
  "validationNotes": [
    "模式与右侧状态等业务字段建议严格验证，renderer 的容错归一化不等于改变规则数据喵。",
    "renderer 对 choice_execute 强制移除标记并使用 use 状态喵。",
    "renderer 只显示单色方块上的 count，多色数量需要预先写入 label 喵。",
    "所有坐标和尺寸都属于显示层，label 是玩家标记的提示和辅助阅读文本喵。",
    "无效、非整数或超出 1 至 15 的 mask 会被归一化过滤，不会转成绿色标记喵。"
  ],
  "installation": {
    "requires": [
      "完整主界面 v3.1",
      "已应用 v3.2 按钮补丁"
    ],
    "command": "python tools/apply_patch.py \"FrontierUI-v3-Patch完整目录\"",
    "installedAssetDirectory": "effect-assets-v3.4/",
    "installedComponent": "preview/effect-row.mjs",
    "standalonePreview": "preview/effect-rows.html",
    "standalonePreviewNeedsInstallation": false,
    "targetDescription": "安装目标是已应用 v3.2 按钮补丁的完整主界面根目录，可以尚未安装 EffectRows，也可以已经安装 v3.3，不是单独的增量补丁目录喵。",
    "supportedEffectRowsBaselines": [
      "none",
      "3.3"
    ],
    "requiresEffectRowsV33First": false,
    "validatesBaselineBeforeWriting": true,
    "backsUpReplacedFiles": true,
    "upgradeNote": "新素材安装到 effect-assets-v3.4/，渲染器继续使用兼容的 v33- 素材标识，旧交付包独立保留喵。"
  },
