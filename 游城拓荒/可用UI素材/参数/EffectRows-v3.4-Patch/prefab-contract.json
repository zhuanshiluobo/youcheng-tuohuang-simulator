{
  "contractVersion": "3.4.0",
  "component": "EffectRow",
  "format": "engine-neutral",
  "description": "三种用途共用暖灰棕纸面底图和独立米灰细边框，保留 v3.3 的模式、数据、交互和布局约定喵。",
  "baseline": {
    "mainInterface": "3.1",
    "mainButtons": "3.2",
    "integration": "在现有引擎内依据该契约组装组件，JSON 本身不是可直接导入的 Unity prefab 喵。"
  },
  "entryPoints": {
    "guide": "EFFECT_ROW_PATCH.md",
    "component": "components/effect-row.mjs",
    "interactivePreview": "preview/effect-rows.html",
    "comparisonPreview": "preview/effect-rows.png",
    "mainExpandedPreview": "preview/main-expanded-details.png",
    "mainQuickPreview": "preview/main-quick.png",
    "beforeAfterPreview": "preview/before-after.png",
    "mainCollapsedPreview": "preview/main-collapsed-details.png",
    "mainScrolledPreview": "preview/main-scrolled-details.png"
  },
  "modes": {
    "choice_execute": {
      "markerSlotsAllowed": [
        0
      ],
      "rightStatusesAllowed": [
        "use"
      ],
      "description": "选择执行时只保留右侧使用入口，强制无左侧玩家标记喵。"
    },
    "persistent_detail": {
      "markerSlotsAllowed": [
        0,
        1,
        2
      ],
      "rightStatusesAllowed": [
        "none",
        "unused",
        "used",
        "use"
      ],
      "description": "永续明细允许没有次数状态，查看他人时通常为只读喵。"
    },
    "quick_action": {
      "markerSlotsAllowed": [
        0,
        1,
        2
      ],
      "rightStatusesAllowed": [
        "none",
        "unused",
        "used",
        "use"
      ],
      "description": "快速行动依规则层给定的数据选择插槽和状态喵。"
    }
  },
  "rowSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "EffectRowV33",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "mode",
      "title",
      "x",
      "y",
      "w"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "mode": {
        "enum": [
          "choice_execute",
          "persistent_detail",
          "quick_action"
        ]
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "description": {
        "type": "string",
        "default": ""
      },
      "markers": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/marker"
        },
        "minItems": 0,
        "maxItems": 2,
        "default": []
      },
      "right": {
        "$ref": "#/$defs/right",
        "default": {
          "status": "none"
        }
      },
      "x": {
        "type": "number"
      },
      "y": {
        "type": "number"
      },
      "w": {
        "type": "number",
        "minimum": 160
      },
      "h": {
        "type": "number",
        "minimum": 48,
        "default": 76
      },
      "bodyAction": {
        "type": "string",
        "minLength": 1
      }
    },
    "$defs": {
      "marker": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mask"
        ],
        "properties": {
          "mask": {
            "type": "integer",
            "minimum": 1,
            "maximum": 15
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "label": {
            "type": "string",
            "default": ""
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "mask": {
                  "not": {
                    "enum": [
                      1,
                      2,
                      4,
                      8
                    ]
                  }
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "count"
                ]
              }
            }
          }
        ]
      },
      "right": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "enum": [
              "none",
              "unused",
              "used",
              "use"
            ]
          },
          "enabled": {
            "type": "boolean",
            "default": true
          }
        }
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "mode": {
              "const": "choice_execute"
            }
          }
        },
        "then": {
          "required": [
            "right"
          ],
          "properties": {
            "markers": {
              "maxItems": 0
            },
            "right": {
              "properties": {
                "status": {
                  "const": "use"
                }
              }
            }
          }
        }
      }
    ]
  },
  "defaults": {
    "mode": "persistent_detail",
    "markers": [],
    "right": {
      "status": "none"
    },
    "rightEnabledWhenOmitted": true,
    "description": "",
    "h": 76
  },
  "layout": {
    "units": "logical-pixels",
    "standardHeight": 76,
    "compactHeight": 60,
    "horizontalPadding": 12,
    "markerSize": 28,
    "markerGap": 4,
    "slotTextGap": 12,
    "rightIconSize": 32,
    "useHitTargetSize": 32,
    "nineSlice": {
      "order": [
        "left",
        "top",
        "right",
        "bottom"
      ],
      "oneX": [
        12,
        12,
        12,
        12
      ],
      "twoX": [
        24,
        24,
        24,
        24
      ]
    },
    "formulas": {
      "markerGroupWidth": "N === 0 ? 0 : N * 28 + (N - 1) * 4",
      "textLeft": "12 + (N > 0 ? markerGroupWidth + 12 : 0)",
      "textRight": "W - 12 - (right.status !== \"none\" ? 32 + 12 : 0)",
      "textWidth": "textRight - textLeft",
      "markerX": "12 + markerIndex * 32",
      "markerY": "(H - 28) / 2",
      "rightIconX": "W - 12 - 32",
      "rightIconY": "(H - 32) / 2"
    },
    "optionalSlotsCollapse": true,
    "textRasterizedIntoTexture": false,
    "markerNumbersRasterizedIntoTexture": false,
    "recommendedTouchHitTargetSize": 44,
    "heightInComparisonPreview": 84
  },
  "players": {
    "order": [
      "Green",
      "Yellow",
      "Blue",
      "Red"
    ],
    "colors": {
