    "countRules": {
      "multiColorCounts": "多色方块不叠加多个数字，将各色数量写入 label，作为提示与辅助阅读文本喵。",
      "emptySlot": "不需要槽时从 markers 中移除，不以 mask=0 表示空槽喵。",
      "singleColorCount": "单色方块用 count 非负整数叠加独立文字，count=0 保持显示，省略字段才隐藏数字喵。"
    }
  },
  "rightStates": [
    {
      "status": "none",
      "interactive": false,
      "reserveWidth": false
    },
    {
      "status": "unused",
      "interactive": false,
      "reserveWidth": true,
      "meaning": "尚未使用的只读状态喵。"
    },
    {
      "status": "used",
      "interactive": false,
      "reserveWidth": true,
      "meaning": "已使用的只读状态喵。"
    },
    {
      "status": "use",
      "enabled": true,
      "interactive": true,
      "reserveWidth": true,
      "visualStates": [
        "default",
        "hover",
        "pressed"
      ],
      "meaning": "当前可执行的使用操作喵。"
    },
    {
      "status": "use",
      "enabled": false,
      "interactive": false,
      "reserveWidth": true,
      "visualStates": [
        "disabled"
      ],
      "meaning": "当前不能执行的使用操作，不等同于已经使用喵。"
    }
  ],
  "interaction": {
    "domActionPattern": "row-use-{id}",
    "bodyAction": "可选，正文区域独立的详情入口，不覆盖右侧使用或状态图标喵。",
    "pointerAndKeyboardGuard": "right.status === \"use\" && right.enabled === true",
    "readOnlyFocusable": false,
    "autoSetUsedOnClick": false,
    "postExecuteStateOwner": "game-rule-layer",
    "focusOverlaySeparate": true,
    "hostBinding": "宿主根据 row.id 映射自己的 actionId，组件不消费 actionId 字段喵。",
    "disabledReason": "宿主可补充禁用原因提示，组件默认文字为当前不可使用喵。",
    "enabledDefaultWarning": "当前组件省略 enabled 时默认可用，正式接入应显式传入规则判定结果喵。",
    "description": "点击仅派发界面操作标识，实际结算、剩余次数与状态变更由游戏逻辑确认喵。"
  },
  "leftPanelExpansion": {
    "referenceCanvas": [
      1920,
      1080
    ],
    "maxExpandedPlayers": 1,
    "defaultExpansionHeight": 224,
    "cityCollapsed": {
      "top": 424,
      "height": 554,
      "bottom": 978
    },
    "cityExpanded": {
      "top": 648,
      "height": 330,
      "bottom": 978
    },
    "formulas": {
      "cityTop": "424 + E",
      "cityHeight": "554 - E",
      "cityBottom": "cityTop + cityHeight = 978"
    },
    "laterPlayerPanelsMoveDown": true,
    "cityArtworkFit": "contain",
    "cityArtworkAspectRatioPreserved": true,
    "scrollContainer": "expanded-details-list",
    "scrollbarSide": "right",
    "scrollbarOwnGutter": true,
    "constraints": [
      "同一时间只展开一名其他玩家，点击另一名时切换展开对象喵。",
      "明细插入对应玩家摘要下方，后续摘要顺次下移喵。",
      "内容溢出在明细内部滚动，不覆盖状态图标喵。",
      "缩放只改变显示尺寸，不改变游戏状态与城市数值喵。"
    ]
  },
